{
  "name": "workout-board",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.14",
  "engines": {
    "bun": ">=1.3.14"
  },
  "scripts": {
    "dev": "WORKOUT_BOARD_DEV=1 bun --hot src/server.ts",
    "start": "bun src/server.ts",
    "build": "bun build src/server.ts --target=bun --outdir=dist --minify",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome format --write .",
    "security": "bun pm scan",
    "check": "bun run typecheck && bun run lint && bun test && bun run build"
  },
  "dependencies": {
    "@napi-rs/keyring": "1.3.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.4",
    "@socketsecurity/bun-security-scanner": "1.1.2",
    "@types/bun": "1.3.14",
    "typescript": "7.0.2"
  },
  "trustedDependencies": []
}
