{
  "name": "workout-board",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.14",
  "engines": {
    "bun": ">=1.3.14"
  },
  "scripts": {
    "prepare": "bun run hooks:install",
    "hooks:install": "git config core.hooksPath .githooks",
    "dev": "tauri dev",
    "dev:frontend": "vite --host 127.0.0.1",
    "build:frontend": "vite build",
    "build": "tauri build --no-bundle",
    "bundle:mac": "tauri build --bundles app,dmg",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome format --write . && cargo fmt --manifest-path src-tauri/Cargo.toml",
    "security": "bun pm scan",
    "check:rust": "cargo fmt --manifest-path src-tauri/Cargo.toml --check && cargo clippy --manifest-path src-tauri/Cargo.toml --all-targets -- -D warnings && cargo test --manifest-path src-tauri/Cargo.toml",
    "check": "bun run typecheck && bun run lint && bun test && bun run check:rust && bun run build",
    "precommit": "bun run check && git diff --cached --check"
  },
  "dependencies": {
    "@napi-rs/keyring": "1.3.0",
    "@tauri-apps/api": "2.11.1"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.4",
    "@socketsecurity/bun-security-scanner": "1.1.2",
    "@tauri-apps/cli": "2.11.4",
    "@types/bun": "1.3.14",
    "typescript": "7.0.2",
    "vite": "8.1.5"
  },
  "trustedDependencies": []
}
